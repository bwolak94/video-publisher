# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/video_publisher

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY=

# ── AWS / S3 / MinIO ──────────────────────────────────────────────────────────
AWS_REGION=eu-central-1
S3_BUCKET_NAME=video-publisher-assets
S3_ENDPOINT_URL=

# ── Application ───────────────────────────────────────────────────────────────
PORT=3001
YOUTUBE_REDIRECT_URI=http://localhost:3002/api/youtube/callback

# ── Worker ────────────────────────────────────────────────────────────────────
WORKER_ENABLED=false
WORKER_CRON_SCHEDULE=0 * * * *
AI_BACKEND_URL=http://localhost:8000
WORKER_MIN_VIRALITY_SCORE=0.65
WORKER_DEDUP_WINDOW_HOURS=48
WORKER_NOTIFICATION_WEBHOOK=

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── fal.ai (KF-02: T2I keyframe generation via Flux) ─────────────────────────
FAL_API_KEY=
